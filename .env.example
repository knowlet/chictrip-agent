# Optional local state/profile locations.
# CHICTRIP_STATE_DIR=/absolute/path/to/private-state
# CHICTRIP_BROWSER_PROFILE_DIR=/absolute/path/to/private-browser-profile
CHICTRIP_BROWSER_CHANNEL=chrome

# Current public web-client header contract. Re-verify against the official
# bundle before changing it.
CHICTRIP_PROVIDER_CLIENT_VERSION=2.0.38

# Undocumented provider writes are intentionally off by default.
CHICTRIP_ENABLE_UNDOCUMENTED_WRITES=0

# Separate opt-in for the observed p1 GetAddWhere + Add item flow.
# This has no effect unless undocumented writes are also enabled.
CHICTRIP_ENABLE_EXPERIMENTAL_ITEM_ADDS=0

# Loopback-only Streamable HTTP MCP endpoint. Set a random 32+ character
# bearer when a client needs a stable credential; otherwise the server prints
# one ephemeral credential to stderr at startup.
CHICTRIP_MCP_HOST=127.0.0.1
CHICTRIP_MCP_PORT=3333
# CHICTRIP_MCP_BEARER_TOKEN=replace-with-a-random-32-plus-character-secret
