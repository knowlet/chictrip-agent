{
  "mcpServers": {
    "chictrip": {
      "title": "去趣行程",
      "description": "Read, preview, and safely synchronize chicTrip itineraries.",
      "command": "node",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": ".",
      "env": {
        "CHICTRIP_ENABLE_UNDOCUMENTED_WRITES": "0",
