{
  "name": "chictrip-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first chicTrip itinerary adapter with a JSON CLI, MCP server, and Codex plugin.",
  "bin": {
    "chictrip": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "tsc --noEmit",
    "cli": "bun run src/cli.ts",
    "mcp:stdio": "bun run src/mcp/stdio.ts",
    "mcp:http": "bun run src/mcp/http.ts",
    "smoke:chat-tunnel": "bun run scripts/smoke-chat-tunnel.ts",
    "test": "bun test",
    "validate": "bun run scripts/validate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright-core": "^1.50.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
